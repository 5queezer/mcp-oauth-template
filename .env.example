# Authenticated mode (default)
MCP_AUTH_MODE=github
BASE_URL=http://localhost:8080
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated immutable numeric GitHub user IDs
GITHUB_ALLOWED_USER_IDS=

# Import-safe application factory
MCP_APP=examples.echo_server:build_app
HOST=127.0.0.1
PORT=8080

# deploy.sh uses a Secret Manager reference instead of GITHUB_CLIENT_SECRET.
# Example: github-client-secret:latest
GITHUB_CLIENT_SECRET_REF=
